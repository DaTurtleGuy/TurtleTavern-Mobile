<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: no title/action bar — the web app fills the screen. -->
    <style name="Theme.TurtleTavern" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#FF1B1B1F</item>
        <item name="android:navigationBarColor">#FF1B1B1F</item>
        <item name="android:windowBackground">#FF1B1B1F</item>
    </style>
</resources>